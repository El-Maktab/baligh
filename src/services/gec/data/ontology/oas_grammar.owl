    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#لا_النافية_للجنس -->

    <Class rdf:about="&arabe;لا_النافية_للجنس">
        <rdfs:subClassOf rdf:resource="&arabe;حرف_نصب"/>
        <rdfs:comment rdf:datatype="&xsd;string"> حرف يعمل للدلالة على نفي الحكم عن جنس أسمها بغير احتمال ، لأكثر من معنى واحد .</rdfs:comment>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#مؤنث -->

    <Class rdf:about="&arabe;مؤنث">
        <rdfs:subClassOf rdf:resource="&arabe;جنس"/>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#مبني_للمجهول -->

    <Class rdf:about="&arabe;مبني_للمجهول">
