    <!-- http://arabicontology.org/oas_grammar.owl#فعل_منصوب -->

    <Class rdf:about="&arabe;فعل_منصوب">
        <equivalentClass>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&arabe;فعل"/>
                    <Class>
                        <complementOf>
                            <Restriction>
                                <onProperty rdf:resource="&arabe;اعرابه"/>
                                <someValuesFrom rdf:resource="&arabe;علامة_الجزم"/>
                            </Restriction>
                        </complementOf>
                    </Class>
                    <Class>
                        <complementOf>
                            <Restriction>
                                <onProperty rdf:resource="&arabe;اعرابه"/>
                                <someValuesFrom rdf:resource="&arabe;علامة_الرفع"/>
                            </Restriction>
                        </complementOf>
                    </Class>
                    <Restriction>
                        <onProperty rdf:resource="&arabe;اعرابه"/>
                        <allValuesFrom rdf:resource="&arabe;علامة_النصب"/>
                    </Restriction>
