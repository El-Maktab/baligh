                    </Class>
                    <Restriction>
                        <onProperty rdf:resource="&arabe;وزنه"/>
                        <allValuesFrom rdf:resource="&arabe;مبني_للمعلوم"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </equivalentClass>
        <rdfs:subClassOf rdf:resource="&arabe;فعل_تام"/>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#فعل_مجزوم -->

    <Class rdf:about="&arabe;فعل_مجزوم">
