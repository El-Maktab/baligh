    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#مثال_المبالغة -->

    <Class rdf:about="&arabe;مثال_المبالغة">
        <rdfs:subClassOf rdf:resource="&arabe;اسم_عامل"/>
        <rdfs:comment rdf:datatype="&xsd;string">أسماء تعمل عمل الفعل حولت للمبالغة من فاعل إلى فعال أو مفعال أو فعول، بكثرة، أو فيل أو فعل ، بقلة.</rdfs:comment>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#مجرد -->

    <Class rdf:about="&arabe;مجرد">
        <rdfs:subClassOf rdf:resource="&arabe;مبني_للمعلوم"/>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#مجرورة_المحل -->

    <Class rdf:about="&arabe;مجرورة_المحل">
        <equivalentClass>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&arabe;جملة"/>
                    <Class>
                        <complementOf>
                            <Restriction>
                                <onProperty rdf:resource="&arabe;اعرابه"/>
                                <someValuesFrom rdf:resource="&arabe;علامة_الرفع"/>
                            </Restriction>
                        </complementOf>
                    </Class>
                    <Class>
                        <complementOf>
                            <Restriction>
                                <onProperty rdf:resource="&arabe;اعرابه"/>
                                <someValuesFrom rdf:resource="&arabe;علامة_النصب"/>
                            </Restriction>
                        </complementOf>
                    </Class>
                    <Restriction>
                        <onProperty rdf:resource="&arabe;اعرابه"/>
                        <allValuesFrom rdf:resource="&arabe;علامة_الجر"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </equivalentClass>
        <rdfs:subClassOf rdf:resource="&arabe;جملة"/>
        <rdfs:comment rdf:datatype="&xsd;string">جملة فعلية معربة في محل جر</rdfs:comment>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#مذكر -->

    <Class rdf:about="&arabe;مذكر">
        <rdfs:subClassOf rdf:resource="&arabe;جنس"/>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#مرفوعة_المحل -->

    <Class rdf:about="&arabe;مرفوعة_المحل">
        <equivalentClass>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&arabe;جملة"/>
                    <Class>
                        <complementOf>
                            <Restriction>
                                <onProperty rdf:resource="&arabe;اعرابه"/>
                                <someValuesFrom rdf:resource="&arabe;علامة_الجر"/>
                            </Restriction>
                        </complementOf>
                    </Class>
                    <Class>
                        <complementOf>
                            <Restriction>
                                <onProperty rdf:resource="&arabe;اعرابه"/>
                                <someValuesFrom rdf:resource="&arabe;علامة_النصب"/>
                            </Restriction>
                        </complementOf>
                    </Class>
                    <Restriction>
                        <onProperty rdf:resource="&arabe;اعرابه"/>
                        <allValuesFrom rdf:resource="&arabe;علامة_الرفع"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </equivalentClass>
        <rdfs:subClassOf rdf:resource="&arabe;جملة"/>
        <rdfs:comment rdf:datatype="&xsd;string">جملة فعلية معربة في محل رفع</rdfs:comment>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#مزيد -->

    <Class rdf:about="&arabe;مزيد">
        <rdfs:subClassOf rdf:resource="&arabe;مبني_للمعلوم"/>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#مستتر_جوازا -->

    <Class rdf:about="&arabe;مستتر_جوازا">
        <rdfs:subClassOf rdf:resource="&arabe;ضمير_مستتر"/>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#مستتر_وجوبا -->

    <Class rdf:about="&arabe;مستتر_وجوبا">
        <rdfs:subClassOf rdf:resource="&arabe;ضمير_مستتر"/>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#معرف_بال -->

    <Class rdf:about="&arabe;معرف_بال">
        <rdfs:subClassOf rdf:resource="&arabe;اسم_معرفة"/>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#معرف_بال_الجنسية -->

    <Class rdf:about="&arabe;معرف_بال_الجنسية">
        <rdfs:subClassOf rdf:resource="&arabe;معرف_بال"/>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#معرف_بال_العهدية -->

    <Class rdf:about="&arabe;معرف_بال_العهدية">
        <rdfs:subClassOf rdf:resource="&arabe;معرف_بال"/>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#معرف_بالاضافة -->

    <Class rdf:about="&arabe;معرف_بالاضافة">
        <rdfs:subClassOf rdf:resource="&arabe;اسم_معرفة"/>
        <rdfs:comment rdf:datatype="&xsd;string">هو اسم نكرة في الأصل وعندما أضيف إلى معرفة تحول إلى معرفة</rdfs:comment>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#معرفة -->

    <Class rdf:about="&arabe;معرفة">
        <rdfs:subClassOf rdf:resource="&arabe;تعيين"/>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#منصوبة_المحل -->

    <Class rdf:about="&arabe;منصوبة_المحل">
        <equivalentClass>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&arabe;جملة"/>
                    <Class>
                        <complementOf>
                            <Restriction>
                                <onProperty rdf:resource="&arabe;اعرابه"/>
                                <someValuesFrom rdf:resource="&arabe;علامة_الجر"/>
                            </Restriction>
                        </complementOf>
                    </Class>
                    <Class>
                        <complementOf>
                            <Restriction>
                                <onProperty rdf:resource="&arabe;اعرابه"/>
                                <someValuesFrom rdf:resource="&arabe;علامة_الرفع"/>
                            </Restriction>
                        </complementOf>
                    </Class>
                    <Restriction>
                        <onProperty rdf:resource="&arabe;اعرابه"/>
                        <allValuesFrom rdf:resource="&arabe;علامة_النصب"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </equivalentClass>
        <rdfs:subClassOf rdf:resource="&arabe;جملة"/>
        <rdfs:comment rdf:datatype="&xsd;string">جملة فعلية معربة منصوبة بعامل نصب</rdfs:comment>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#موصول_حرفي -->

    <Class rdf:about="&arabe;موصول_حرفي">
        <rdfs:subClassOf rdf:resource="&arabe;حرف"/>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#موصول_مختص -->

    <Class rdf:about="&arabe;موصول_مختص">
        <rdfs:subClassOf rdf:resource="&arabe;اسم_موصول"/>
        <rdfs:comment rdf:datatype="&xsd;string">كل اسم موصول يختص بنوع معين سواء أكان مفردا ، أو مثنى ، أو جمعا ، مذكرا ، أو مؤنثا ، وألفاظه هي : الذي ، التي ، اللذان ، اللتان ، اللذين ، اللتين ، الذين ، الألى ، اللاتي ، اللائي .</rdfs:comment>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#موصول_مشترك -->

    <Class rdf:about="&arabe;موصول_مشترك">
        <rdfs:subClassOf rdf:resource="&arabe;اسم_موصول"/>
        <rdfs:comment rdf:datatype="&xsd;string">كل اسم موصول يشترك فيه جميع الأنواع المفردة ، والمثناة ، والمجموعة ، والمذكرة ، والمؤنثة ، ولكن يمكن التوصل إلى المقصود منه بوساطة القرينة ، أو الضمير العائد عليه ، حيث اشترطوا فيه أن يطابق اللفظ والمعنى . والأسماء الموصولة المشتركة هي : من ، ما ، أي ، أل ، ذا وذو</rdfs:comment>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#نكرة -->

    <Class rdf:about="&arabe;نكرة">
        <rdfs:subClassOf rdf:resource="&arabe;تعيين"/>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#نكرة_منصوبة -->

    <Class rdf:about="&arabe;نكرة_منصوبة">
        <equivalentClass>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&arabe;اسم_منصوب"/>
                    <rdf:Description rdf:about="&arabe;اسم_نكرة"/>
                </intersectionOf>
            </Class>
        </equivalentClass>
        <rdfs:subClassOf rdf:resource="&arabe;اسم_منصوب"/>
        <rdfs:comment rdf:datatype="&xsd;string">اسم منصوب لا يدل على معيّن.</rdfs:comment>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#نواصب_المضارع -->

    <Class rdf:about="&arabe;نواصب_المضارع">
        <rdfs:subClassOf rdf:resource="&arabe;حرف_نصب"/>
        <rdfs:comment xml:lang="ar">فئة تتضمن العناصر الآتية: أن،لن،كي،وإذن</rdfs:comment>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#وزن -->

    <Class rdf:about="&arabe;وزن"/>
    


    <!-- http://arabicontology.org/oas_grammar.owl#وزن_الفعل -->

    <Class rdf:about="&arabe;وزن_الفعل">
        <rdfs:subClassOf rdf:resource="&arabe;وزن"/>
    </Class>
    


