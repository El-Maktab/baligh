                        <allValuesFrom rdf:resource="&arabe;علامة_الجزم"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </equivalentClass>
        <rdfs:subClassOf rdf:resource="&arabe;فعل"/>
    </Class>
    


    <!-- http://arabicontology.org/oas_grammar.owl#فعل_مرفوع -->

    <Class rdf:about="&arabe;فعل_مرفوع">
        <equivalentClass>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&arabe;فعل"/>
