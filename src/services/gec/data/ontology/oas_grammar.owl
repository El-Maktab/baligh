                        <complementOf>
                            <Restriction>
                                <onProperty rdf:resource="&arabe;وزنه"/>
                                <allValuesFrom rdf:resource="&arabe;مبني_للمعلوم"/>
                            </Restriction>
                        </complementOf>
                    </Class>
                    <Restriction>
                        <onProperty rdf:resource="&arabe;وزنه"/>
                        <allValuesFrom rdf:resource="&arabe;مبني_للمجهول"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </equivalentClass>
        <rdfs:subClassOf rdf:resource="&arabe;فعل_تام"/>
    </Class>
    


