[
  {
    "kind": 1,
    "language": "markdown",
    "value": "## Random Query",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "PREFIX owl: <http://www.w3.org/2002/07/owl#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nSELECT DISTINCT ?relation ?domain ?range WHERE {\n    ?relation a owl:ObjectProperty .\n    ?relation rdfs:domain ?domain .\n    ?relation rdfs:range ?range .\n}\n",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "PREFIX owl: <http://www.w3.org/2002/07/owl#>\n\nSELECT DISTINCT ?restrictionType\nWHERE {\n    ?r a owl:Restriction .\n    ?r ?restrictionType ?x .\n}",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "\n\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX oas: <http://arabicontology.org/oas_grammar.owl#>\n\nSELECT DISTINCT ?role ?property ?expectedClass WHERE {\n    {\n        <http://arabicontology.org/oas_grammar.owl#فاعل> rdfs:domain ?class .\n        BIND(\"domain\" AS ?role)\n    } UNION {\n        <http://arabicontology.org/oas_grammar.owl#فاعل> rdfs:range ?class .\n        BIND(\"range\" AS ?role)\n    }\n\n    ?class rdfs:subClassOf* ?targetClass .\n    \n    {\n        ?targetClass owl:equivalentClass ?rest .\n        ?rest owl:onProperty ?property .\n        ?rest owl:allValuesFrom ?expectedClass .\n    } UNION {\n        ?targetClass owl:equivalentClass ?rest .\n        ?rest owl:intersectionOf ?list .\n        ?list rdf:rest*/rdf:first ?item .\n        ?item owl:onProperty ?property .\n        ?item owl:allValuesFrom ?expectedClass .\n    } UNION {\n        ?targetClass rdfs:subClassOf ?rest .\n        ?rest a owl:Restriction .\n        ?rest owl:onProperty ?property .\n        ?rest owl:allValuesFrom ?expectedClass .\n    }\n}",
    "metadata": {}
  },
  {
    "kind": 1,
    "language": "markdown",
    "value": "## Subject–Verb Agreement",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "PREFIX oas:  <http://arabicontology.org/oas_grammar.owl#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n\nSELECT\n    ?subject_case\n    ?verb_number\n    ?verb_gender\nWHERE {\n    oas:فاعل rdfs:domain ?subject_case .\n\n    BIND(<http://arabicontology.org/oas_grammar.owl#مذكر> AS ?verb_gender)\n    BIND(oas:مفرد AS ?verb_number)\n}",
    "metadata": {}
  },
  {
    "kind": 1,
    "language": "markdown",
    "value": "## Noun–Adjective Agreement",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "PREFIX oas:  <http://arabicontology.org/oas_grammar.owl#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n\nSELECT\n    ?expected_case\n    ?expected_gender\n    ?expected_number\n    ?expected_definiteness\nWHERE {\n    BIND(oas:اسم_مرفوع AS ?expected_case)\n    BIND(oas:مذكر AS ?expected_gender)\n    BIND(oas:مفرد AS ?expected_number)\n    BIND(oas:نكرة AS ?expected_definiteness)\n}",
    "metadata": {}
  },
  {
    "kind": 1,
    "language": "markdown",
    "value": "## Idafa Construction",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "PREFIX oas:  <http://arabicontology.org/oas_grammar.owl#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n\nSELECT\n    ?expected_mudaf_alieh_case\n    ?expected_mudaf_definiteness\nWHERE {\n    oas:مضاف_اليه rdfs:domain ?expected_mudaf_alieh_case .\n\n    BIND(oas:نكرة AS ?expected_mudaf_definiteness)\n}",
    "metadata": {}
  }
]
